rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Safe role lookup: returns null if the profile doc is missing so rules
    // fail closed instead of throwing during evaluation.
    function requesterRole() {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
             : null;
    }

    function isOwnerOrManager() {
      return isSignedIn() && requesterRole() in ['owner', 'manager'];
    }

    function isOwner() {
      return isSignedIn() && requesterRole() == 'owner';
    }

    // USERS
    // Own profile: full self-edit except role.
    // Owner/Manager: read all (dashboard Users panel).
    // Owner only: change another user's role (and only the role field).
    // Founding Owner UID is permanently locked against role changes.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isOwnerOrManager());

      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.role in ['job-seeker', 'employer']
                    && request.resource.data.keys().hasAll(['name', 'email', 'role']);

      allow update: if isSignedIn() && (
                      (
                        // Self-edit: may change any field except role
                        request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                      )
                      ||
                      (
                        // Owner-only role promotion/demotion
                        isOwner()
                        && uid != "0v3eFQ3jwPV871MxFEq5FH1fgil2"
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role'])
                        && request.resource.data.role in [
                             'job-seeker', 'employer', 'owner', 'manager',
                             'business-partner', 'harvester', 'employee'
                           ]
                      )
                    );

      allow delete: if false;
    }

    // JOBS — public read. Create restricted by role.
    // Poster or Owner/Manager may fully edit/delete.
    // Any signed-in user may only increment applicants / views (by exactly 1).
    match /jobs/{jobId} {
      allow read: if true;

      allow create: if isSignedIn()
                    && request.resource.data.postedByUid == request.auth.uid
                    && request.resource.data.postedByRole in
                       ['owner', 'manager', 'business-partner', 'employer', 'harvester']
                    && request.resource.data.title is string
                    && request.resource.data.title.size() > 0
                    && request.resource.data.title.size() <= 200
                    && request.resource.data.company is string
                    && request.resource.data.company.size() > 0
                    && request.resource.data.company.size() <= 120
                    && request.resource.data.keys().hasAll([
                         'title', 'company', 'postedByUid', 'postedByRole', 'status'
                       ]);

      allow update: if isSignedIn() && (
                      // Full edit by original poster
                      (
                        resource.data.postedByUid == request.auth.uid
                        // Poster may not reassign ownership or role stamp
                        && request.resource.data.postedByUid == resource.data.postedByUid
                        && request.resource.data.postedByRole == resource.data.postedByRole
                      )
                      ||
                      // Full moderation by Owner / Manager
                      isOwnerOrManager()
                      ||
                      // Counter-only updates: must be exact +1 on one or both
                      // fields. Missing counters on legacy docs are treated as 0.
                      (
                        request.resource.data.diff(resource.data).affectedKeys()
                          .hasOnly(['applicants', 'views'])
                        && (
                             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['applicants'])
                             || request.resource.data.applicants
                                  == (resource.data.get('applicants', 0) + 1)
                           )
                        && (
                             !request.resource.data.diff(resource.data).affectedKeys().hasAny(['views'])
                             || request.resource.data.views
                                  == (resource.data.get('views', 0) + 1)
                           )
                      )
                    );

      allow delete: if isSignedIn() && (
                      resource.data.postedByUid == request.auth.uid || isOwnerOrManager()
                    );
    }

    // APPLICATIONS — deterministic id "{applicantUid}_{jobId}"
    match /applications/{appId} {
      allow read: if isSignedIn() && (
                    resource.data.applicantUid == request.auth.uid ||
                    resource.data.employerUid == request.auth.uid ||
                    isOwnerOrManager()
                  );

      allow create: if isSignedIn()
                    && request.resource.data.applicantUid == request.auth.uid
                    && appId == request.auth.uid + '_' + request.resource.data.jobId
                    && request.resource.data.keys().hasAll([
                         'jobId', 'applicantUid', 'applicantEmail', 'appliedAt', 'status'
                       ]);

      // Employer or Owner/Manager may only touch status / notes
      allow update: if isSignedIn()
                    && (resource.data.employerUid == request.auth.uid || isOwnerOrManager())
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'notes']);

      allow delete: if isSignedIn() && isOwner();
    }

    // APPLY4ME LEADS — public create (lead-gen form), staff read only
    match /apply4meLeads/{leadId} {
      allow read: if isSignedIn() && requesterRole() in ['owner', 'manager', 'employee'];

      allow create: if request.resource.data.name is string
                    && request.resource.data.email is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 120
                    && request.resource.data.email.size() > 3
                    && request.resource.data.email.size() <= 254
                    && request.resource.data.email.matches('.*@.*\\..*')
                    && (!('phone' in request.resource.data)
                        || (request.resource.data.phone is string
                            && request.resource.data.phone.size() <= 30))
                    && (!('message' in request.resource.data)
                        || (request.resource.data.message is string
                            && request.resource.data.message.size() <= 2000));

      allow update: if false;
      allow delete: if isSignedIn() && isOwner();
    }
  }
}
